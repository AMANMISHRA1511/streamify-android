<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#050409"
    android:fitsSystemWindows="true">

    <LinearLayout
        android:id="@+id/dynamicIsland"
        android:layout_width="310dp"
        android:layout_height="62dp"
        android:layout_gravity="top|center_horizontal"
        android:layout_marginTop="8dp"
        android:background="@drawable/dynamic_island_bg"
        android:elevation="24dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="7dp"
        android:visibility="gone">

        <ImageView
            android:id="@+id/islandArtwork"
            android:layout_width="46dp"
            android:layout_height="46dp"
            android:scaleType="centerCrop"/>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="9dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/islandTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="#FFFFFF"
                android:textSize="14sp"
                android:textStyle="bold"/>

            <TextView
                android:id="@+id/islandArtist"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="#9DA6B2"
                android:textSize="11sp"/>
        </LinearLayout>

        <TextView
            android:id="@+id/islandPlay"
            android:layout_width="42dp"
            android:layout_height="42dp"
            android:gravity="center"
            android:text="▶"
            android:textColor="#FFFFFF"
            android:textSize="18sp"/>
    </LinearLayout>

    <TextView
        android:id="@+id/musicLightShortcut"
        android:layout_width="52dp"
        android:layout_height="52dp"
        android:layout_gravity="end|bottom"
        android:layout_marginEnd="16dp"
        android:layout_marginBottom="166dp"
        android:background="@drawable/music_light_button_bg"
        android:elevation="24dp"
        android:gravity="center"
        android:text="✦"
        android:textColor="#E91DFF"
        android:textSize="25sp"/>

    <com.aman.streamify.MusicLightView
        android:id="@+id/musicLightView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clickable="false"
        android:focusable="false"
        android:importantForAccessibility="no"
        android:visibility="gone"/>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:paddingStart="18dp"
            android:paddingTop="14dp"
            android:paddingEnd="18dp"
            android:paddingBottom="8dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="56dp"
                android:layout_weight="1"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:layout_width="52dp"
                    android:layout_height="52dp"
                    android:src="@drawable/streamify_logo"
                    android:scaleType="centerInside"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:text="Streamify"
                    android:textColor="#FFFFFF"
                    android:textSize="25sp"
                    android:textStyle="bold"/>
            </LinearLayout>

            <TextView
                android:layout_width="46dp"
                android:layout_height="46dp"
                android:background="@drawable/profile_circle"
                android:gravity="center"
                android:text="A"
                android:textColor="#E91DFF"
                android:textSize="18sp"
                android:textStyle="bold"/>
        </LinearLayout>

        <FrameLayout
            android:id="@+id/content"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <ScrollView
                android:id="@+id/homeScreen"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:fillViewport="true">

                <LinearLayout
                    android:id="@+id/homeContainer"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingStart="14dp"
                    android:paddingEnd="14dp"
                    android:paddingBottom="170dp"/>
            </ScrollView>

            <LinearLayout
                android:id="@+id/searchScreen"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical"
                android:padding="14dp"
                android:visibility="gone">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Search"
                    android:textColor="#FFFFFF"
                    android:textSize="28sp"
                    android:textStyle="bold"/>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginTop="14dp">

                    <EditText
                        android:id="@+id/searchBox"
                        android:layout_width="0dp"
                        android:layout_height="54dp"
                        android:layout_weight="1"
                        android:background="@drawable/search_bg"
                        android:hint="Song, artist or language"
                        android:paddingHorizontal="16dp"
                        android:singleLine="true"
                        android:textColor="#FFFFFF"
                        android:textColorHint="#8994A3"/>

                    <TextView
                        android:id="@+id/voiceButton"
                        android:layout_width="54dp"
                        android:layout_height="54dp"
                        android:layout_marginStart="8dp"
                        android:background="@drawable/search_bg"
                        android:gravity="center"
                        android:text="🎙"
                        android:textSize="21sp"/>
                </LinearLayout>

                <TextView
                    android:id="@+id/searchStatus"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingTop="10dp"
                    android:textColor="#8E9AA8"/>

                <ScrollView
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1">

                    <LinearLayout
                        android:id="@+id/searchResults"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:paddingBottom="170dp"/>
                </ScrollView>
            </LinearLayout>

            <ScrollView
                android:id="@+id/libraryScreen"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:visibility="gone">

                <LinearLayout
                    android:id="@+id/libraryContainer"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="14dp"
                    android:paddingBottom="170dp"/>
            </ScrollView>

            <ScrollView
                android:id="@+id/historyScreen"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:visibility="gone">

                <LinearLayout
                    android:id="@+id/historyContainer"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="14dp"
                    android:paddingBottom="170dp"/>
            </ScrollView>

        </FrameLayout>

        <LinearLayout
            android:id="@+id/miniPlayer"
            android:layout_width="match_parent"
            android:layout_height="82dp"
            android:layout_marginHorizontal="10dp"
            android:layout_marginBottom="6dp"
            android:background="@drawable/mini_player_bg"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="10dp"
            android:visibility="gone">

            <ImageView
                android:id="@+id/miniArtwork"
                android:layout_width="58dp"
                android:layout_height="58dp"
                android:scaleType="centerCrop"/>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/miniTitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:maxLines="1"
                    android:textColor="#FFFFFF"
                    android:textSize="16sp"
                    android:textStyle="bold"/>

                <TextView
                    android:id="@+id/miniArtist"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:maxLines="1"
                    android:textColor="#8E9AA8"
                    android:textSize="13sp"/>
            </LinearLayout>

            <TextView
                android:id="@+id/prevButton"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:gravity="center"
                android:text="⏮"
                android:textColor="#FFFFFF"
                android:textSize="22sp"/>

            <TextView
                android:id="@+id/playButton"
                android:layout_width="52dp"
                android:layout_height="52dp"
                android:background="@drawable/play_circle"
                android:gravity="center"
                android:text="▶"
                android:textColor="#FFFFFF"
                android:textSize="20sp"/>

            <TextView
                android:id="@+id/nextButton"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:gravity="center"
                android:text="⏭"
                android:textColor="#FFFFFF"
                android:textSize="22sp"/>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="72dp"
            android:background="#09080F"
            android:gravity="center"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/navHome"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="center"
                android:text="⌂&#10;Home"
                android:textColor="#E91DFF"/>

            <TextView
                android:id="@+id/navSearch"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="center"
                android:text="⌕&#10;Search"
                android:textColor="#8E9AA8"/>

            <TextView
                android:id="@+id/navLibrary"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="center"
                android:text="♫&#10;Library"
                android:textColor="#8E9AA8"/>

            <TextView
                android:id="@+id/navHistory"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="center"
                android:text="◷&#10;History"
                android:textColor="#8E9AA8"/>
        </LinearLayout>

    </LinearLayout>
</FrameLayout>